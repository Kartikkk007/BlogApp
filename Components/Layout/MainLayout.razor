@inherits LayoutComponentBase
@inject BlogApp.Services.SimpleAuthService AuthService
@inject NavigationManager Navigation
@* Inject your JWT provider to handle manual logout calls *@
@inject BlogApp.Services.JwtAuthenticationStateProvider AuthStateProvider 

<div class="page">
    <main>
        <div class="top-row px-4 text-end">
            @* Wrap the login/logout navigation layout inside an AuthorizeView *@
            <AuthorizeView>
                <Authorized>
                    <span class="me-3 text-muted">Hello, Admin!</span>
                    <button class="btn btn-link text-danger p-0 m-0 align-baseline" @onclick="Logout">
                        Logout
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="/admin/login">Admin Login</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-webassembly-simulate="error">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <a href="." class="dismiss">🗙</a>
</div>

@code {
    private void Logout()
    {
        // Use your custom JWT auth state provider to wipe the token identities
        AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/");
    }
}